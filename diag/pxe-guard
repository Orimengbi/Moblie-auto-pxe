#!/bin/sh
# 验机脚本的 PATH 包装。只拦截本地磁盘，放行 tmpfs 和其他命令。
cmd=$(basename "$0")
if [ "$cmd" = "pxe-guard" ]; then
  cmd=$1
  shift
fi

local_disk() {
  printf '%s\n' "$1" | grep -E -q '^/dev/(sd|nvme|mmcblk|hd|vd|xvd|mapper/)'
}

refuse() {
  echo "pxe-guard: 拒绝 ${cmd} $* （验机模式不允许改动本地硬盘）" >&2
  exit 99
}

case "$cmd" in
  mount|umount|wipefs|mkfs|mkfs.*)
    for arg in "$@"; do
      local_disk "$arg" && refuse "$@"
    done
    ;;
  dd)
    for arg in "$@"; do
      case "$arg" in
        if=*|of=*)
          local_disk "${arg#*=}" && refuse "$@"
          ;;
      esac
    done
    ;;
esac

if [ -n "${PXE_GUARD_BIN_ROOT:-}" ]; then
  set -- $PXE_GUARD_BIN_ROOT
else
  set -- /bin /sbin /usr/bin /usr/sbin
fi
real=""
for dir in "$@"; do
  if [ -x "$dir/$cmd" ]; then
    real="$dir/$cmd"
    break
  fi
done
if [ -z "$real" ]; then
  echo "pxe-guard: 找不到 $cmd" >&2
  exit 127
fi
exec "$real" "$@"
