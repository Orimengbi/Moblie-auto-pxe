#!/bin/sh
# 内存验机代理。由 Alpine local.d 启动，不挂载本地硬盘。
set -u
ROOT=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
if [ -f "$ROOT/block-check.sh" ]; then
  . "$ROOT/block-check.sh"
elif [ -f /usr/local/lib/pxe-diag/block-check.sh ]; then
  . /usr/local/lib/pxe-diag/block-check.sh
fi

log() {
  printf '%s\n' "$*"
  printf '%s\n' "$*" > /dev/console 2>/dev/null || true
}

esc() {
  printf '%s' "$1" | tr '\r\n\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

cmdline() {
  key=$1
  for arg in $(cat /proc/cmdline); do
    case "$arg" in
      "$key"=*) printf '%s' "${arg#*=}"; return 0 ;;
    esac
  done
}

SERVER=$(cmdline PXE_SERVER)
if [ -z "${SERVER}" ]; then
  SERVER=${PXE_SERVER:-}
fi
if [ -z "${SERVER}" ]; then
  log "缺少 PXE_SERVER，无法回传"
  exit 1
fi

MAC=""
for iface in /sys/class/net/*; do
  name=$(basename "$iface")
  [ "$name" = "lo" ] && continue
  addr=$(cat "$iface/address" 2>/dev/null || true)
  [ -n "$addr" ] && [ "$addr" != "00:00:00:00:00:00" ] || continue
  if ip -4 addr show "$name" 2>/dev/null | grep -q 'inet '; then
    MAC=$addr
    break
  fi
  [ -z "$MAC" ] && MAC=$addr
done
[ -n "$MAC" ] || MAC="00:00:00:00:00:00"
log "验机代理启动 ${MAC}"

host=${SERVER#http://}
host=${host%%/*}
i=0
while [ "$i" -lt 20 ]; do
  if ping -c 1 -W 1 "$host" >/dev/null 2>&1; then
    break
  fi
  i=$((i + 1))
  sleep 1
done

fetch() {
  url=$1
  dest=$2
  if command -v curl >/dev/null 2>&1; then
    curl -fsS "$url" -o "$dest"
  else
    wget -qO "$dest" "$url"
  fi
}

fetch "${SERVER}/boot/diag/task.sh?mac=${MAC}" /tmp/pxe-task.sh || {
  log "领取验机任务失败"
  exit 1
}
# shellcheck disable=SC1091
. /tmp/pxe-task.sh

started=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u)
checks_json=""
scripts_json=""
mount_violation=0

mounted_disks() {
  awk '$1 ~ /^\/dev\/(sd|nvme|mmcblk|vd|hd|xvd)/ { print $1, $2 }' /proc/mounts
}

if mounted_disks | grep -q .; then
  mount_violation=1
  log "开始前已经挂着本地磁盘"
fi

add_check() {
  name=$1
  ok=$2
  summary=$3
  detail=$4
  item=$(printf '{"name":"%s","ok":%s,"summary":"%s","detail":"%s"}' "$(esc "$name")" "$ok" "$(esc "$summary")" "$(esc "$detail")")
  if [ -n "$checks_json" ]; then
    checks_json="${checks_json},${item}"
  else
    checks_json=$item
  fi
}

want() {
  case " ${PXE_CHECKS:-} " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

add_output() {
  name=$1
  detail=$2
  summary=$(printf '%s\n' "$detail" | head -n 2 | tr '\n' ' ')
  [ -n "$summary" ] || summary="没有输出"
  add_check "$name" true "$summary" "$detail"
}

if want cpu; then
  detail=$(lscpu 2>/dev/null || sed -n '1,20p' /proc/cpuinfo)
  add_output cpu "$detail"
fi
if want memory; then
  detail=$(awk '/MemTotal|MemAvailable|MemFree/{print}' /proc/meminfo)
  if command -v dmidecode >/dev/null 2>&1; then
    detail="${detail}
$(dmidecode -t memory 2>/dev/null | awk 'NR<=40')"
  fi
  if command -v memtester >/dev/null 2>&1; then
    detail="${detail}
$(memtester 64M 1 2>&1 || true)"
  fi
  add_output memory "$detail"
fi
if want nic; then
  detail=$(ip -br addr 2>/dev/null || ip addr)
  if command -v ethtool >/dev/null 2>&1; then
    for iface in /sys/class/net/*; do
      name=$(basename "$iface")
      [ "$name" = "lo" ] && continue
      detail="${detail}
$(ethtool "$name" 2>/dev/null | awk 'NR<=8')"
    done
  fi
  add_output nic "$detail"
fi
if want thermal; then
  if [ -d /sys/class/thermal ]; then
    detail=$(awk '{print FILENAME, $1}' /sys/class/thermal/thermal_zone*/temp 2>/dev/null || echo "没有读到温度")
  else
    detail="没有温度传感器"
  fi
  add_output thermal "$detail"
fi
if want disk; then
  detail=$(lsblk -d -o NAME,SIZE,MODEL,TRAN,ROTA 2>/dev/null || lsblk -d)
  if command -v smartctl >/dev/null 2>&1; then
    lsblk -dn -o NAME,TYPE 2>/dev/null | awk '$2=="disk"{print $1}' | while IFS= read -r disk; do
      [ -n "$disk" ] || continue
      echo "== ${disk}"
      smartctl -H -i "/dev/${disk}" || true
    done > /tmp/pxe-smart.txt
    detail="${detail}
$(cat /tmp/pxe-smart.txt)"
  fi
  add_output disk "$detail"
fi
if want firmware; then
  if command -v dmidecode >/dev/null 2>&1; then
    detail=$(dmidecode -t system 2>/dev/null || true)
  else
    detail=$(cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name /sys/class/dmi/id/product_serial 2>/dev/null || echo "没有 DMI")
  fi
  add_output firmware "$detail"
fi

n=1
while [ "$n" -le "${PXE_SCRIPT_COUNT:-0}" ]; do
  eval "id=\$PXE_SCRIPT_${n}_ID"
  eval "name_b64=\$PXE_SCRIPT_${n}_NAME_B64"
  name=$(printf '%s' "$name_b64" | base64 -d 2>/dev/null || printf '%s' "$name_b64")
  eval "url=\$PXE_SCRIPT_${n}_URL"
  eval "timeout=\${PXE_SCRIPT_${n}_TIMEOUT:-120}"
  dest="/tmp/pxe-script-${n}.sh"
  blocked=false
  timed_out=false
  code=0
  output=""
  if fetch "$url" "$dest"; then
    if pxe_script_blocked "$dest"; then
      blocked=true
      code=99
      output="脚本包含挂载或写入本地磁盘的命令，未执行"
    else
      export PATH="/usr/local/lib/pxe-guard:${PATH}"
      output=$(timeout "$timeout" /bin/sh "$dest" 2>&1) || code=$?
      if [ "$code" -eq 124 ]; then
        timed_out=true
      fi
    fi
  else
    code=1
    output="下载脚本失败"
  fi
  item=$(printf '{"id":"%s","name":"%s","exitCode":%s,"timedOut":%s,"blocked":%s,"output":"%s"}' "$(esc "$id")" "$(esc "$name")" "$code" "$timed_out" "$blocked" "$(esc "$output")")
  if [ -n "$scripts_json" ]; then
    scripts_json="${scripts_json},${item}"
  else
    scripts_json=$item
  fi
  n=$((n + 1))
done

if mounted_disks | grep -q .; then
  mount_violation=1
fi
finished=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u)
ok=true
if [ "$mount_violation" -eq 1 ]; then
  ok=false
fi
printf '{"mac":"%s","startedAt":"%s","finishedAt":"%s","checks":[%s],"scripts":[%s],"mountViolation":%s,"ok":%s}\n' \
  "$(esc "$MAC")" "$started" "$finished" "$checks_json" "$scripts_json" \
  "$([ "$mount_violation" -eq 1 ] && echo true || echo false)" \
  "$ok" > /tmp/pxe-report.json

if command -v curl >/dev/null 2>&1; then
  curl -fsS -H 'content-type: application/json' --data-binary @/tmp/pxe-report.json "${PXE_REPORT}" >/dev/null || log "回传失败"
else
  wget -qO- --header='Content-Type: application/json' --post-file=/tmp/pxe-report.json "${PXE_REPORT}" >/dev/null || log "回传失败"
fi

log "验机结束。结果已尝试回传。系统停在内存里，不会重启去安装。"
if [ "$mount_violation" -eq 1 ]; then
  log "检测到本地磁盘被挂载，报告记为失败。"
fi
while true; do
  sleep 3600
done
